{
  "expo": {
    "name": "Snowwy",
    "slug": "snowwy",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snowwy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.snowwy.tracker",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ru",
        "CFBundleLocalizations": [
          "ru"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCE8F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0A1523",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Snowwy использует геопозицию, чтобы записывать ваши спуски: скорость, расстояние и перепад высот.",
          "locationAlwaysAndWhenInUsePermission": "Snowwy использует геопозицию в фоне, чтобы запись спусков продолжалась при заблокированном экране.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.snowwy.tracker.widgets",
          "groupIdentifier": "group.app.snowwy.tracker"
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/images/notification-icon.png",
          "color": "#2F6FED"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Snowwy использует барометр телефона, чтобы точнее считать перепад высот на спусках."
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Snowwy использует камеру, чтобы сканировать QR-код с приглашением в группу друзей.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "Snowwy использует фото, чтобы поставить аватарку и баннер в вашем профиле.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "android": {
      "package": "app.snowwy.tracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-foreground.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    }
  }
}
